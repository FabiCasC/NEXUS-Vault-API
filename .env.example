# Copia este archivo a .env (NUNCA subas .env real a GitHub, ya está en .gitignore)

# Carpeta del dataset (opcional; por defecto usa ../KNOWLEDGE_NEXUS_LATAM_DATA_V1_RC2_PARTICIPANTS)
# DATA_DIR=C:\ruta\a\KNOWLEDGE_NEXUS_LATAM_DATA_V1_RC2_PARTICIPANTS

# Etiquetado de skills con ChatGPT (opcional). Si no lo pones o USE_LLM=0,
# el sistema sigue funcionando igual, solo con matching por palabra clave.
USE_LLM=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Portal (useportal.co) - canal de "actividad institucional en vivo"
# (opcional). Publica un evento cada vez que se genera una propuesta nueva.
# Acepta PORTAL_SECRET o, si te dieron llaves con el nombre del track,
# API_EDUCACION_SECRET (se usa igual, sin renombrar nada).
PORTAL_API_URL=https://api.useportal.co
PORTAL_SECRET=
PORTAL_CHANNEL_ID=nexus-vault-activity
