# Copia este archivo a .env (NUNCA subas .env real a GitHub, ya está en .gitignore)

# Carpeta del dataset (opcional; por defecto usa ../KNOWLEDGE_NEXUS_LATAM_DATA_V1_RC2_PARTICIPANTS)
# DATA_DIR=C:\ruta\a\KNOWLEDGE_NEXUS_LATAM_DATA_V1_RC2_PARTICIPANTS

# Etiquetado de skills con ChatGPT (opcional). Si no lo pones o USE_LLM=0,
# el sistema sigue funcionando igual, solo con matching por palabra clave.
USE_LLM=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
